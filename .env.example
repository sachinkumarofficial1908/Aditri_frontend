# Frontend environment (Vite)
# Only VITE_* keys are exposed to browser bundles.

VITE_APP_NAME=
VITE_APP_ENV=auto
VITE_APP_URL=auto
# Dev server and proxy targets
VITE_DEV_SERVER_PORT=
VITE_BACKEND_ORIGIN=

# API/public runtime values
VITE_API_BASE_URL=auto
VITE_UPLOADS_BASE_URL=auto
VITE_API_TIMEOUT_MS=

# Browser storage keys and routes
VITE_AUTH_TOKEN_KEY=
VITE_AUTH_USER_KEY=
VITE_CART_KEY=
VITE_LOGIN_PATH=

# Firebase Phone Auth
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
